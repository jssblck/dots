# Each top-level dir mirrors a home agent dir:
#   dotclaude  <->  ~/.claude
#   dotcodex   <->  ~/.codex
#   dotagents  <->  ~/.agents
# SYNC.md is the source of truth for what gets backed up (the allowlist).
#
# This file is only a safety net: it hard-blocks auth, secrets, sessions, logs,
# sqlite, and other machine state from ever being committed, even if an
# automated sync step copies more than the allowlist intends.

# --- Claude (dotclaude <- ~/.claude) ---
dotclaude/.credentials.json
dotclaude/.last-cleanup
dotclaude/settings.local.json
dotclaude/history.jsonl
dotclaude/mcp-needs-auth-cache.json
dotclaude/stats-cache.json
dotclaude/backups/
dotclaude/cache/
dotclaude/chrome/
dotclaude/debug/
dotclaude/file-history/
dotclaude/paste-cache/
dotclaude/plans/
dotclaude/projects/
dotclaude/session-env/
dotclaude/sessions/
dotclaude/shell-snapshots/
dotclaude/tasks/

# --- Codex (dotcodex <- ~/.codex) ---
dotcodex/auth.json
dotcodex/*.json
dotcodex/*.json.bak
dotcodex/*.json.tmp-*
dotcodex/config.toml.bak-*
dotcodex/*.sqlite
dotcodex/*.sqlite-*
dotcodex/.personality_migration
dotcodex/cap_sid
dotcodex/installation_id
dotcodex/session_index.jsonl
dotcodex/.sandbox/
dotcodex/.sandbox-bin/
dotcodex/.sandbox-secrets/
dotcodex/.tmp/
dotcodex/archived_sessions/
dotcodex/automations/
dotcodex/browser/
dotcodex/cache/
dotcodex/computer-use/
dotcodex/computer-use-turn-ended/
dotcodex/generated_images/
dotcodex/memories/
dotcodex/node_repl/
dotcodex/pets/
dotcodex/process_manager/
dotcodex/sessions/
dotcodex/sqlite/
dotcodex/tmp/
dotcodex/vendor_imports/
dotcodex/worktrees/

# Repo-local snapshots (if any)
.backup/

# --- WSL bootstrap safety net ---
wsl/secrets/
wsl/private/
wsl/**/*.env
wsl/**/config.toml
!wsl/templates/**/config.toml.example
wsl/**/*.key
wsl/**/*.pem
wsl/**/*.p12
wsl/**/*.pfx
wsl/**/id_*
wsl/**/*token*
wsl/**/*auth*
wsl/**/*state*
wsl/**/*.log
wsl/**/*.pid
wsl/**/*.vhd
wsl/**/*.vhdx
